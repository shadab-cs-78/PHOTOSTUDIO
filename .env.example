# ==============================================================================
# PHOTOVAULT — 100% Free Zero-Card Multi-Cloud Storage & Database Credentials (.env)
# ZERO DEBIT/CREDIT CARD REQUIRED ANYWHERE!
# ==============================================================================

# 1. SUPABASE (Database + Storage + Auth - 500MB DB + Storage Free - ZERO CARD)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=wedding-photos

# 2. CLOUDINARY (Primary Storage - 25GB Free - ZERO CARD)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 3. IMAGEKIT (Alternative Fast CDN Storage - 20GB Free - ZERO CARD)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# 4. BACKBLAZE B2 (Reserve Storage - 10GB Free - ZERO CARD)
BACKBLAZE_KEY_ID=your_b2_key_id
BACKBLAZE_APPLICATION_KEY=your_b2_app_key
BACKBLAZE_BUCKET_NAME=photovault-reserve

# 5. FIREBASE STORAGE (Overflow Storage - 5GB Free on Spark Plan - ZERO CARD)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# 6. RESEND (Email Alerts - 3,000 emails/mo Free - ZERO CARD)
RESEND_API_KEY=re_your_resend_api_key
